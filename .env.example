# Copy to .env.local and fill in. Never commit .env.local.

# --- E-Mail (Resend) ------------------------------------------------------
# Domain diamond-night.de muss im Resend-Dashboard verifiziert sein,
# sonst weist Resend den Versand ab.
EMAIL_PROVIDER=resend
RESEND_API_KEY=

# --- Zahlung (Stripe) -----------------------------------------------------
# Karte, PayPal und Klarna müssen im Stripe-Dashboard aktiviert sein,
# sonst weist Stripe die Checkout-Session ab.
# Testschlüssel beginnt mit sk_test_, Live-Schlüssel mit sk_live_.
PAYMENT_PROVIDER=stripe
STRIPE_SECRET_KEY=
# Signaturgeheimnis des Webhook-Endpunkts (Stripe -> Entwickler -> Webhooks).
# Lokal: stripe listen --forward-to localhost:3000/api/stripe/webhook
STRIPE_WEBHOOK_SECRET=

# --- Eventplattform (Ticket-Datenbank) ------------------------------------
# Dorthin werden bezahlte Bestellungen als Tickets gemeldet; dort scannt die
# Security. TICKET_API_TOKEN muss in beiden Projekten identisch sein.
PLATFORM_API_URL=http://localhost:3100
TICKET_API_TOKEN=
PLATFORM_EVENT_SLUG=diamond-night-2026
